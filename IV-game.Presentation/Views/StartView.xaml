<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="IV_game.Presentation.Views.StartView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowSpacing="16" MaxWidth="900">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Välj ett patientfall att öva på"
                   FontSize="20"
                   FontWeight="SemiBold" />

        <ListView x:Name="CaseList"
                  Grid.Row="1"
                  SelectionMode="Single"
                  IsItemClickEnabled="False" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
            <Button x:Name="StartButton"
                    Content="Starta spel"
                    Style="{ThemeResource AccentButtonStyle}"
                    Click="OnStartClick" />
            <Button Content="Topplista"
                    Click="OnHighScoresClick" />
        </StackPanel>
    </Grid>
</UserControl>
